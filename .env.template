# Copy this file to .env and replace every example path before starting Compose.
# Compose reads .env automatically; do not commit your populated .env file.

# Host interface and port for the dashboard. 127.0.0.1 is local-only.
# Set to 0.0.0.0 or a trusted LAN address to allow other devices to connect.
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=3003

# Existing external Docker network shared with the integrated services.
BITCOIN_DOCKER_NETWORK=bitcoin

# Host paths mounted read-only into the collector. Use absolute paths.
BITCOIN_CONFIG_PATH=/path/to/bitcoin.conf
JOINMARKET_ENV_PATH=/path/to/joinmarket/.env
LND_TLS_CERT_PATH=/path/to/lnd/tls.cert
LND_DASHBOARD_MACAROON_PATH=/path/to/lnd/dashboard.macaroon
ELECTRS_DATA_PATH=/path/to/electrs/database

# Persistent dashboard history database. Relative paths are based on this file.
DASHBOARD_STATE_PATH=./state

# Collector polling period in seconds.
POLL_SECONDS=60
